{
  "manifest_version": 3,
  "name": "Copy Stack",
  "version": "1.0.0",
  "description": "Keep recently copied text and restore any saved value to the clipboard.",
  "permissions": ["storage", "clipboardWrite"],
  "background": {
    "service_worker": "src/background.ts"
  },
  "action": {
    "default_title": "Copy Stack",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.ts"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
